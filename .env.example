# =============================================================================
# Polyglot Code Studio — Environment Configuration (.env.example)
# Regenerated from FeatureFlagRegistry (Single Source of Truth)
# Phase 10.9 Consolidation
# =============================================================================

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# WS_PORT: Unified HTTP upgrade alongside Express server on port 3000
WS_PORT="3000"

# CLAIM_TTL_MS: Blueprint Lease Claim TTL in milliseconds (Default: 1800000 = 30 minutes)
CLAIM_TTL_MS="1800000"

# -----------------------------------------------------------------------------
# Runtime Feature Flags
# -----------------------------------------------------------------------------
# Phase 10.5: Finite Element Method Epistemic Verification (Default: false)
ENABLE_FEMEV="false"

# Phase 10.6: PastaLean Python -> Lean 4 Translation Bridge (Default: false)
ENABLE_PASTALEAN="false"

# Phase 10.6: Lungo Multi-Language Verification & Code Export (Default: false)
ENABLE_LUNGO="false"

# Phase 10.7: LeanFlow Autoformalization & Research Prover (Default: false)
ENABLE_LEANFLOW="false"

# Phase 10.7: leanscreen Semantic Fidelity Screening Gate (Default: false)
ENABLE_LEANSCREEN="false"

# Phase 10.7: LaTeX Document Ingestion & Span Ledger (Default: false)
ENABLE_LATEX_INGESTION="false"

# Phase 10.8: LeanCert Certified Numerical Verification (Default: false)
ENABLE_LEANCERT="false"

# Phase 10.8: Lean Finder V2 Semantic Search (Default: true)
ENABLE_LEAN_FINDER_V2="true"

# Phase 10.8: LeanSearch v2 Reasoning Mode Search (Default: true)
ENABLE_LEANSEARCH_V2="true"

# Phase 10.8: LeanExplore Multi-Package Search (Default: true)
ENABLE_LEANEXPLORE="true"

# Phase 10.3: Native Lean LSP MCP Server Hub (Default: false)
ENABLE_MCP_SERVER="false"

# Phase 10.3: Streamable HTTP MCP Transport (Default: false)
ENABLE_MCP_HTTP_TRANSPORT="false"

# Phase 10.3: Lean Reservoir Package Registry Client (Default: true)
ENABLE_LEAN_RESERVOIR="true"

# -----------------------------------------------------------------------------
# Tooling Feature Flags
# -----------------------------------------------------------------------------
# Phase 10.8: NumpySpec Matrix Verification (Default: false)
ENABLE_NUMPYSPEC="false"

# Phase 10.8: Nerodia Lean C-Extension Compiler (Default: false)
ENABLE_NERODIA="false"

# Phase 10.8: Provepy Educational Autoformalization (Default: false)
ENABLE_PROVEPY="false"

# Phase 10.8: Lean Source Code Formatter (Default: false)
ENABLE_LEAN_FMT="false"

# Phase 10.8: Heron AST Linter & Code Actions (Default: false)
ENABLE_HERON="false"

# Phase 10.8: Verso Blueprint Engine (Default: false)
ENABLE_VERSO="false"

# Phase 10.8: Lean Atlas 8-Edge Interactive Canvas Viewer (Default: false)
ENABLE_LEAN_ATLAS="false"

# -----------------------------------------------------------------------------
# Experimental Feature Flags
# -----------------------------------------------------------------------------
# Phase 10.8: CRAMF Context-Retrieval Augmented Math Formalization (Default: false)
ENABLE_CRAMF="false"

# Phase 10.3: Archon Horizon Multi-Agent Prover Swarm (Default: false)
ENABLE_ARCHON_HORIZON="false"

# Phase 8: Duper Automated Prover (Default: false)
ENABLE_DUPER="false"

# Phase 8: LeanSage Computer Algebra (Default: false)
ENABLE_LEANSAGE="false"

# Phase 10.1: Dynamic Pyodide PEP 783 WASM Wheel Builder (Default: false)
ENABLE_PYODIDE_BUILD="false"

# -----------------------------------------------------------------------------
# Phase 10.9.5: Selective Integrations
# -----------------------------------------------------------------------------
# Phase 10.9.5: Paperproof Interactive Proof-Tree Playback (Default: false)
ENABLE_PAPERPROOF="false"

# Phase 10.9.5: Mathesis Natural-Language to Lean 4 Autoformalization Bridge (Default: false)
ENABLE_MATHESIS="false"

# Phase 10.9.5: Educational Mode Templates (Robo, Lean4Game) (Default: false)
ENABLE_EDUCATIONAL_MODE="false"

# -----------------------------------------------------------------------------
# Phase 10.9.7: Unified Search & LSpec CI Template
# -----------------------------------------------------------------------------
# Phase 10.9.7: Unified Mathlib Search via Reciprocal Rank Fusion (Default: true)
ENABLE_UNIFIED_SEARCH="true"

# Phase 10.9.7: LSpec GitHub Actions CI Template Generator (Default: false)
ENABLE_LSPEC_CI_TEMPLATE="false"

# -----------------------------------------------------------------------------
# Phase 10.10: LLM-Native Access Layer (MCP, Gateway, Tool Search & Agent Skills)
# -----------------------------------------------------------------------------
# Phase 10.10: MCP server/discover discovery endpoint (Default: true)
ENABLE_MCP_DISCOVER="true"

# Phase 10.10: MCP 2026-07-28 stateless server compliance (Default: true)
ENABLE_MCP_STATELESS="true"

# Phase 10.10: Progressive tool discovery (3 virtual tools, 80% token reduction) (Default: false)
ENABLE_TOOL_SEARCH="false"

# Phase 10.10: Optional LiteLLM/Agentgateway proxy for function-only providers (Default: false)
ENABLE_MCP_GATEWAY="false"

# Phase 10.10: AAIF Agent Skills bundle generation for Claude Code, Codex CLI, Cursor (Default: false)
ENABLE_SKILL_BUNDLES="false"

# Phase 10.10: Enable DeepSeek, Kimi, and MiniMax reasoning provider integrations (Default: false)
ENABLE_DEEPSEEK_KIMI_MINIMAX="false"

# -----------------------------------------------------------------------------
# Phase 11.0.1: IDE Shell, Advanced Editing & Windows-Style File Manager
# -----------------------------------------------------------------------------
# Phase 11.0.1: VSCode-style Activity Bar (Default: true)
ENABLE_ACTIVITY_BAR="true"

# Phase 11.0.1: Windows Explorer-style File Manager with ZIP & Trash (Default: true)
ENABLE_FILE_MANAGER="true"

# Phase 11.0.1: Monaco Diff Viewer for changes & review (Default: true)
ENABLE_DIFF_VIEWER="true"

# Phase 11.0.1: Optional @enjoys/context-engine language intelligence (Default: false)
ENABLE_CONTEXT_ENGINE="false"

# -----------------------------------------------------------------------------
# Phase 11.0.2: LLM Chat, Settings UI & Automations
# -----------------------------------------------------------------------------
# Phase 11.0.2: LLM Chat and conversational prover (Default: false)
ENABLE_LLM_CHAT="false"

# Phase 11.0.2: Fullscreen comprehensive Settings modal (Default: true)
ENABLE_SETTINGS_UI="true"

# Phase 11.0.2: Autonomous agentic automation with guardrails (Default: false)
ENABLE_AGENTIC_AUTOMATION="false"

# Phase 11.0.2: Project Scaffolding wizard and templates (Default: true)
ENABLE_PROJECT_SCAFFOLDING="true"

# -----------------------------------------------------------------------------
# Phase 11.1: lean-beam Speculative Tactic Execution
# -----------------------------------------------------------------------------
# Phase 11.1: Speculative tactic execution via lean-beam MCP (Default: false)
ENABLE_LEAN_BEAM="false"

# -----------------------------------------------------------------------------
# Phase 11.2: Workspace Archive, Paperproof, OpenTelemetry, Mathesis & Yjs CRDT
# -----------------------------------------------------------------------------
# Phase 11.2: Deterministic .polyglot workspace archive & backup/restore (Default: true)
ENABLE_WORKSPACE_ARCHIVE="true"

# Phase 11.2: Interactive Paperproof proof playback tab in FemevDrawer (Default: false)
ENABLE_PAPERPROOF_PLAYBACK="false"

# Phase 11.2: OpenTelemetry browser telemetry (Default: false, local OTLP only)
ENABLE_OTEL_BROWSER="false"

# Phase 11.2: OpenTelemetry backend node telemetry (Default: false, local OTLP only)
ENABLE_OTEL_NODE="false"

# Phase 11.2: Real-time multi-user CRDT collaboration via Hocuspocus/Yjs (Default: false)
ENABLE_YJS_COLLABORATION="false"

# Phase 11.2: Optional Mathesis remote API endpoint (HuggingFace Space or vLLM)
MATHESIS_ENDPOINT=""

# -----------------------------------------------------------------------------
# Policy Flags
# -----------------------------------------------------------------------------
# Phase 10.5: Enforce strict goal resolution without admit/sorry in pipeline (Default: false)
PIPELINE_STRICT_GOALS="false"

# -----------------------------------------------------------------------------
# Phase 12: Proof Reuse, Proposal Loop, Translation Fidelity & Conditional Integrations
# -----------------------------------------------------------------------------
ENABLE_PROOF_REUSE="true"
ENABLE_PROPOSAL_LOOP="false"
ENABLE_TRANSLATION_FIDELITY="true"
ENABLE_LP2="false"
ENABLE_TREETHINK="false"

# -----------------------------------------------------------------------------
# Phase 13: Unified Result Contracts, Contract Parity & Native Notebook
# -----------------------------------------------------------------------------
ENABLE_RESULT_ENVELOPE="true"
ENABLE_CONTRACT_PARITY="true"
ENABLE_NOTEBOOK="true"
ENABLE_CONFIG_MANAGER="true"

# -----------------------------------------------------------------------------
# Phase 13.9: Security, Authentication, Rate Limiting & Secret Management
# -----------------------------------------------------------------------------
# CORS_ORIGINS: Comma-separated list of allowed origins
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Rate Limits (Sliding Window): General endpoints (100 rpm), MCP endpoints (30 rpm)
RATE_LIMIT_RPM="100"
MCP_RATE_LIMIT_RPM="30"

# CI Test Secret Bypass Guard
# STRICT GUARD: ALLOW_CI_BYPASS is strictly ignored unless NODE_ENV === "test".
# Never enable or set ALLOW_CI_BYPASS in production.
ALLOW_CI_BYPASS="false"
POLYGLOT_CI_TEST_SECRET=""

